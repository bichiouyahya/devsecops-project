            "shape": "actor",
            "id": "8bec9b76-fc78-4c62-a311-acc5840db150",
            "zIndex": 4,
            "data": {
              "type": "tm.Actor",
              "name": "Google OAuth",
              "description": "External identity provider used for 'Log in with Google'.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "ee6ef76b-cc58-41c5-af8e-5b8657b2576d",
                  "number": 3,
                  "title": "OAuth accounts get a predictable password",
                  "type": "Spoofing",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "Users created through OAuth get a local password derived from their email address, so anyone who knows the email can log in with the normal form.\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL) + code review",
                  "mitigation": "Do not create a local password for OAuth users, or generate a random one; validate the ID token server side.",
                  "new": false
                }
              ],
              "hasOpenThreats": true,
              "providesAuthentication": true
            }
          },
          {
            "position": {
              "x": 440,
              "y": 280
            },
            "size": {
              "width": 150,
              "height": 150
            },
            "attrs": {
              "text": {
                "text": "Juice Shop API\n(Node.js / Express)"
              },
              "body": {
                "stroke": "#333333",
                "strokeWidth": 1.5,
                "strokeDasharray": ""
              }
            },
            "visible": true,
            "shape": "process",
            "id": "20404bd1-c1e2-4e32-8341-d0df7fb1d5d4",
            "zIndex": 5,
            "data": {
              "type": "tm.Process",
              "name": "Juice Shop API\n(Node.js / Express)",
              "description": "Express server exposing the REST API and serving the Angular frontend. Runs in a Docker container.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "76803ec0-2f52-47c8-ab60-d74ecfebf6ad",
                  "number": 4,
                  "title": "JWT forgery with a hardcoded signing key",
                  "type": "Spoofing",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The RSA private key used to sign JWTs is hardcoded in lib/insecurity.ts. Anyone with the source can forge a token for any user, including the admin.\n\nDetected by pipeline stage: Secrets scan (Gitleaks, pre-commit) + SAST",
                  "mitigation": "Move the key to a secret manager or environment secret, rotate it, and verify the algorithm on every token (reject 'none').",
                  "new": false
                },
                {
                  "id": "b4e977ec-ce50-44a8-bd03-f245aed402c5",
                  "number": 5,
                  "title": "IDOR on basket API",
                  "type": "Elevation of privilege",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "GET /rest/basket/:id returns any basket by id without checking it belongs to the logged in user.\n\nDetected by pipeline stage: Security unit tests",
                  "mitigation": "Check ownership server side: the basket id must match the id in the user's token.",
                  "new": false
                },
                {
                  "id": "ca9cd09f-0bb9-4e7c-a242-f6fbbda8b892",
                  "number": 6,
                  "title": "Mass assignment on registration",
                  "type": "Elevation of privilege",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "POST /api/Users accepts a 'role' field, so a new user can register directly as admin.\n\nDetected by pipeline stage: Security unit tests + SAST",
                  "mitigation": "Whitelist accepted fields on registration and always set the role server side.",
                  "new": false
                },
                {
                  "id": "556ed71a-e634-44e0-bff4-c3b50282dcba",
                  "number": 7,
                  "title": "No audit log of sensitive actions",
                  "type": "Repudiation",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "Admin actions, login failures and payment changes are not recorded in a protected log, so attacks cannot be traced.\n\nDetected by pipeline stage: Code review",
                  "mitigation": "Structured security logging of authentication, authorization failures and admin actions, shipped to a central log store.",
                  "new": false
                },
                {
                  "id": "5ebcd845-480c-4a09-87a3-32580bbf755d",
                  "number": 8,
                  "title": "Vulnerable third party npm packages",
                  "type": "Tampering",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The API depends on many npm packages, some with known CVEs. A vulnerable or compromised dependency runs with the app's privileges.\n\nDetected by pipeline stage: SCA (Trivy fs, npm audit, Dependabot) + SBOM (Syft)",
                  "mitigation": "Keep dependencies updated, pin versions with the lockfile, generate an SBOM, block builds with CRITICAL CVEs.",
                  "new": false
                },
                {
                  "id": "0f90481d-3473-40e3-bfa7-4b68aa663c00",
                  "number": 9,
                  "title": "Container image with excess privileges or vulnerable OS packages",
                  "type": "Elevation of privilege",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "If the container runs as root or the base image has known CVEs, an RCE in the app gives the attacker more control over the host.\n\nDetected by pipeline stage: Dockerfile scan (Hadolint, Checkov) + image scan (Trivy) + signing (Cosign)",
                  "mitigation": "Run as a non-root USER, use a minimal base image, scan the image on every build, sign it.",
                  "new": false
                }
              ],
              "hasOpenThreats": true
            }
          },
