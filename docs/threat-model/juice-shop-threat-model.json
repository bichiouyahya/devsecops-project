            "id": "e97ef27c-f4f0-4f4e-b4cb-9a500275c566",
            "zIndex": 6,
            "data": {
              "type": "tm.Store",
              "name": "SQLite database\n(users, products, baskets)",
              "description": "Relational database accessed through Sequelize and some raw SQL queries.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "3c2093e3-9ea6-4aaf-8bc1-c3d6fc6938fa",
                  "number": 10,
                  "title": "Passwords stored as unsalted MD5",
                  "type": "Information disclosure",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "User passwords are hashed with MD5 and no salt. After any SQL injection dump they are cracked in seconds.\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL)",
                  "mitigation": "Hash passwords with bcrypt or Argon2 with a per user salt.",
                  "new": false
                },
                {
                  "id": "043a00cf-6ade-41ef-bb1f-cdc18d39734b",
                  "number": 11,
                  "title": "Database file not encrypted at rest",
                  "type": "Information disclosure",
                  "severity": "Low",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The SQLite file sits unencrypted inside the container; anyone with access to the volume reads all data.\n\nDetected by pipeline stage: IaC / config review (Checkov)",
                  "mitigation": "Encrypt the volume or move to a managed database with encryption at rest and least privilege accounts.",
                  "new": false
                }
              ],
              "hasOpenThreats": true,
              "isALog": false,
              "storesCredentials": true,
              "isEncrypted": false,
              "isSigned": false
            }
          },
          {
            "position": {
              "x": 840,
              "y": 320
            },
            "size": {
              "width": 180,
              "height": 80
            },
            "attrs": {
              "text": {
                "text": "MarsDB NoSQL\n(reviews, orders)"
              },
              "topLine": {
                "stroke": "#333333",
                "strokeWidth": 1.5,
                "strokeDasharray": ""
              },
              "bottomLine": {
                "stroke": "#333333",
                "strokeWidth": 1.5,
                "strokeDasharray": ""
              }
            },
            "visible": true,
            "shape": "store",
            "id": "89e6fdd4-daa1-4a26-847f-292f01afa338",
            "zIndex": 7,
            "data": {
              "type": "tm.Store",
              "name": "MarsDB NoSQL\n(reviews, orders)",
              "description": "In-memory MongoDB-like store for product reviews and orders.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "3c093b4c-d34f-4be5-b1b5-1882b8ce442f",
                  "number": 12,
                  "title": "NoSQL injection modifies other users' reviews",
                  "type": "Tampering",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "PATCH /rest/products/reviews passes the request body straight into the update query, so operators like $ne update many reviews at once.\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL)",
                  "mitigation": "Validate types (id must be a string), never pass raw request objects to queries, update by exact id only.",
                  "new": false
                },
                {
                  "id": "39ef4a0a-2e0d-4fb5-9132-3adb5fc0e0df",
                  "number": 13,
                  "title": "NoSQL $where injection blocks the server",
                  "type": "Denial of service",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The product review lookup builds a $where expression from user input, so a payload like sleep() freezes the event loop.\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL) + DAST",
                  "mitigation": "Remove $where queries, validate input, set query timeouts.",
                  "new": false
                },
                {
                  "id": "c23c60d8-ebea-4200-b89e-cbd079f5b032",
                  "number": 14,
                  "title": "Review posted under another user's name",
                  "type": "Spoofing",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The review author is taken from the request body instead of the session, so a user can post as someone else.\n\nDetected by pipeline stage: Security unit tests",
                  "mitigation": "Take the author from the authenticated token, ignore it in the body.",
                  "new": false
                }
              ],
              "hasOpenThreats": true,
              "isALog": false,
              "storesCredentials": false,
              "isEncrypted": false,
              "isSigned": false
            }
          },
          {
            "position": {
              "x": 840,
              "y": 570
            },
            "size": {
              "width": 180,
              "height": 80
            },
            "attrs": {
              "text": {
                "text": "File storage\n(/ftp, uploads)"
              },
              "topLine": {
                "stroke": "#333333",
                "strokeWidth": 1.5,
