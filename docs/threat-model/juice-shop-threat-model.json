            "id": "31b2b889-dad5-47e6-9a4e-042e8bae9b78",
            "zIndex": 2,
            "data": {
              "type": "tm.Actor",
              "name": "Customer\n(browser)",
              "description": "Registered or anonymous shopper using the Angular single page app.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "3df516fe-b854-49a0-ae9c-c9c9a39336e0",
                  "number": 1,
                  "title": "Weak passwords and no MFA by default",
                  "type": "Spoofing",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "Customer accounts accept weak passwords and MFA is optional, so accounts can be taken over by guessing or credential stuffing.\n\nDetected by pipeline stage: DAST (OWASP ZAP) + code review",
                  "mitigation": "Enforce a password policy, check passwords against breached lists, encourage or require 2FA.",
                  "new": false
                },
                {
                  "id": "ed02cf04-f08a-4a7d-856e-bdd08a2a9f19",
                  "number": 2,
                  "title": "Customer can deny placing an order",
                  "type": "Repudiation",
                  "severity": "Low",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "Orders and payments are not tied to a tamper evident audit trail, so a customer can dispute an action and we cannot prove it.\n\nDetected by pipeline stage: Code review",
                  "mitigation": "Log order and payment events with user id, timestamp and request id to an append only log.",
                  "new": false
                }
              ],
              "hasOpenThreats": true,
              "providesAuthentication": false
            }
          },
