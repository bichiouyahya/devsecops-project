            "data": {
              "type": "tm.Flow",
              "name": "HTML, JSON, JWT token",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "protocol": "HTTP",
              "isEncrypted": false,
              "isPublicNetwork": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "95153000-8e4f-4461-9e5c-d62a8adee8f2",
                  "number": 22,
                  "title": "Cross site scripting in search results",
                  "type": "Tampering",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The frontend renders the search term with bypassSecurityTrustHtml, so injected script runs in the victim's browser and can steal the JWT from localStorage.\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL) + DAST",
                  "mitigation": "Never bypass Angular sanitization, encode output, add a strict Content Security Policy.",
                  "new": false
                },
                {
                  "id": "8a354696-9547-4ecd-87bc-2ceb2f6fa93b",
                  "number": 23,
                  "title": "Error responses leak stack traces",
                  "type": "Information disclosure",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "Unhandled errors return the full stack trace and framework details to the client.\n\nDetected by pipeline stage: DAST (OWASP ZAP) + security unit tests",
                  "mitigation": "Generic error handler in production, log details server side only.",
                  "new": false
                },
                {
                  "id": "268d12d5-63ac-4d6f-a9ae-1e0d282426e6",
                  "number": 24,
                  "title": "Missing security headers",
                  "type": "Information disclosure",
                  "severity": "Low",
                  "status": "Open",
