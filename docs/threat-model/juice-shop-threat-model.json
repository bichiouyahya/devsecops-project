            "visible": true,
            "shape": "store",
            "id": "0aa60402-02bb-4363-b75e-48e5bda64774",
            "zIndex": 8,
            "data": {
              "type": "tm.Store",
              "name": "File storage\n(/ftp, uploads)",
              "description": "Server folders holding downloadable files (/ftp) and user uploads (complaints, profile images).",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "3a3f6bdf-c2d9-4732-82cd-fc4e2c3db4ca",
                  "number": 15,
                  "title": "/ftp folder exposes confidential files",
                  "type": "Information disclosure",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The /ftp directory is browsable and contains internal documents and backup files such as package.json.bak.\n\nDetected by pipeline stage: DAST (OWASP ZAP)",
                  "mitigation": "Remove sensitive files, disable directory listing, require authentication for internal documents.",
                  "new": false
                },
                {
                  "id": "45ec3179-b314-4a12-aa88-68a86a3c5d01",
                  "number": 16,
                  "title": "File type filter bypass with a poison null byte",
                  "type": "Information disclosure",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The /ftp route only serves .md and .pdf, but an encoded null byte (%2500) bypasses the check and downloads any file.\n\nDetected by pipeline stage: DAST (OWASP ZAP) + SAST",
                  "mitigation": "Normalize and decode the path before checking it, use an allow list of exact file names.",
                  "new": false
                },
                {
                  "id": "ea230962-846e-4678-8927-f8ea9af4839a",
                  "number": 17,
                  "title": "Unrestricted file upload",
                  "type": "Tampering",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "Upload size and type are only checked in the frontend, so crafted uploads (oversized files, XML with external entities) reach the server.\n\nDetected by pipeline stage: SAST + DAST",
                  "mitigation": "Validate type, size and content server side, disable XML external entities in the parser.",
                  "new": false
                }
              ],
              "hasOpenThreats": true,
              "isALog": false,
              "storesCredentials": false,
              "isEncrypted": false,
              "isSigned": false
            }
          },
