            "data": {
              "type": "tm.Flow",
              "name": "HTTP requests\n(login, search, basket, upload, reviews)",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "protocol": "HTTP",
              "isEncrypted": false,
              "isPublicNetwork": true,
              "isTrustBoundary": false,
              "threats": [
                {
                  "id": "c82639fe-b2b6-4906-b6d6-3006a45528b4",
                  "number": 18,
                  "title": "SQL injection bypasses login",
                  "type": "Spoofing",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "routes/login.ts builds the SQL query by concatenating email and password, so ' OR 1=1-- logs in as the first user (admin).\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL) + security unit tests",
                  "mitigation": "Use parameterized queries (Sequelize replacements or the ORM), never string concatenation.",
                  "new": false
                },
                {
                  "id": "120802c0-a82f-4470-a44a-e4dfe587753c",
                  "number": 19,
                  "title": "SQL injection in product search dumps the database",
                  "type": "Information disclosure",
                  "severity": "High",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "routes/search.ts injects the q parameter into a raw query, so a UNION SELECT returns the whole Users table.\n\nDetected by pipeline stage: SAST (Semgrep / CodeQL) + DAST",
                  "mitigation": "Parameterized query, input validation, least privilege database account.",
                  "new": false
                },
                {
                  "id": "11a80c89-94ba-4945-8ee6-c14c892fda6b",
                  "number": 20,
                  "title": "Brute force on login, no rate limiting",
                  "type": "Spoofing",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The login endpoint has no rate limit or lockout, so passwords can be guessed at high speed.\n\nDetected by pipeline stage: DAST (OWASP ZAP)",
                  "mitigation": "Rate limit by IP and account, progressive delays, lockout alerts.",
                  "new": false
                },
                {
                  "id": "e0665509-2f9d-4107-9c4c-5124df0c38ca",
                  "number": 21,
                  "title": "Traffic not protected by TLS",
                  "type": "Information disclosure",
                  "severity": "Medium",
                  "status": "Open",
                  "score": "",
                  "modelType": "STRIDE",
                  "description": "The app is served over plain HTTP, so credentials and tokens can be sniffed on the network.\n\nDetected by pipeline stage: DAST (OWASP ZAP)",
                  "mitigation": "Terminate TLS in front of the app and send HSTS.",
                  "new": false
                }
              ],
              "hasOpenThreats": true
            },
            "id": "be921433-c095-458a-8bcd-7c7a5144de5f",
            "labels": [
