{
  "version": "2.6.2",
  "summary": {
    "title": "OWASP Juice Shop",
    "owner": "DevSecOps project team",
    "description": "E-commerce web app with an Angular frontend, a Node.js / Express API, a SQLite database and a MarsDB NoSQL store, shipped as a Docker image. Deliberately vulnerable. Target of our DevSecOps pipeline. Each threat names the pipeline stage that detects it.",
    "id": 0
  },
  "detail": {
    "contributors": [
      {
        "name": "Yahya Bichiou"
      },
      {
        "name": "Mohamed Amine Bettaieb"
      }
    ],
